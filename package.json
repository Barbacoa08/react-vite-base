{
	"name": "react-vite-base",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"all": "pnpm clean && pnpm i && pnpm style-check && pnpm build && pnpm test",
		"github": "pnpm clean && pnpm i && pnpm lint && pnpm build && pnpm test",
		"clean": "rm -rf build dist",
		"lint": "biome ci ./src",
		"format": "biome format --write ./src",
		"style-check": "biome check --write ./src",
		"dev": "netlify dev",
		"dev:client-only": "vite --open",
		"build": "tsc -b && vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"preview": "vite preview"
	},
	"dependencies": {
		"@barbajoe/css-lib": "0.2.1",
		"@netlify/functions": "4.2.7",
		"chart.js": "4.5.0",
		"react": "19.1.1",
		"react-chartjs-2": "5.3.0",
		"react-dom": "19.1.1",
		"react-router-dom": "7.9.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.0",
		"@testing-library/react": "16.3.0",
		"@testing-library/react-hooks": "8.0.1",
		"@testing-library/user-event": "14.6.1",
		"@types/jest-axe": "3.5.9",
		"@types/react": "19.1.17",
		"@types/react-dom": "19.1.11",
		"@vitejs/plugin-react": "5.0.4",
		"@vitest/coverage-v8": "3.2.4",
		"globals": "16.4.0",
		"jest-axe": "10.0.0",
		"jsdom": "27.0.0",
		"typescript": "5.9.3",
		"vite": "7.1.7",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.4"
	}
}
